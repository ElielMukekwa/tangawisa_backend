APP_NAME=Tangawisa API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/tangawisa
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Accepts comma-separated origins or a JSON list.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
