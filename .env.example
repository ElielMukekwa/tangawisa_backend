APP_NAME=Tangawisa API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# Local development. Replace with the Supabase Transaction pooler URL in production.
DATABASE_URL=sqlite:///./tangawisa_dev.db
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Accepts comma-separated origins or a JSON list.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000
BOOTSTRAP_DATABASE=true
SEED_DEVELOPMENT_DATA=true
DISABLE_DATABASE_POOLING=false
MEDIA_STORAGE_BACKEND=local

# Required on Vercel when MEDIA_STORAGE_BACKEND=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=site-presentation
